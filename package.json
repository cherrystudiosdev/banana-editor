{
  "name": "banana-editor",
  "version": "1.0.0",
  "description": "Open-source editing. Creative freedom.",
  "author": "Banana Editor contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/assets.mjs && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:core": "vitest run tests/core tests/ai tests/persistence",
    "test:media": "vitest run tests/media",
    "test:e2e": "playwright test",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "package:win": "pnpm build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "pnpm build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "lucide-react": "1.63.0",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "org.bananaeditor.desktop",
    "productName": "Banana Editor",
    "directories": { "output": "release", "buildResources": "resources" },
    "files": ["dist/**/*", "package.json"],
    "asarUnpack": ["node_modules/sharp/**/*", "node_modules/@img/**/*"],
    "extraResources": [{ "from": "resources/ffmpeg", "to": "ffmpeg" }, { "from": "resources/fonts", "to": "fonts" }, { "from": "resources/icon.ico", "to": "icon.ico" }, { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "resources/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "artifactName": "Banana-Editor-${version}-x64-Setup.${ext}" },
    "portable": { "artifactName": "Banana-Editor-${version}-x64-Portable.${ext}" },
    "fileAssociations": [{ "ext": "banana", "name": "Banana Editor project", "role": "Editor" }]
  }
}
